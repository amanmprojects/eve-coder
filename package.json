{
  "name": "eve-coder",
  "version": "2.0.0",
  "description": "A fully-local coding agent built on eve. npm i -g eve-coder, run `eve-coder` in any directory, and a TUI opens that reads/writes your files on this machine (no sandbox).",
  "type": "module",
  "bin": {
    "eve-coder": "bin/eve-coder.mjs"
  },
  "files": [
    "agent",
    "bin",
    "tui",
    ".output",
    "tsconfig.json",
    "README.md"
  ],
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "build": "eve build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "dev": "eve dev",
    "start": "eve start",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@opentui/core": "^0.1.97",
    "@opentui/react": "^0.1.97",
    "@vercel/connect": "0.4.3",
    "ai": "^7.0.58",
    "eve": "^0.38.3",
    "react": "^19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/react": "^19",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ai": "^7.0.58"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "eve",
    "agent",
    "coding-agent",
    "cli",
    "ai"
  ],
  "license": "MIT"
}
